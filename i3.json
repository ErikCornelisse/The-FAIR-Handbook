{"version":3,"kind":"Article","sha256":"3c45b7779d45f8da2860df42d476d3072f06c54afe0762d13f1da0db60141e94","slug":"i3","location":"/i3.md","dependencies":[],"frontmatter":{"title":"Qualified References","content_includes_title":false,"authors":[{"name":"TNO","collaboration":true,"id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/dualslash/The-FAIR-Handbook","copyright":"2026","numbering":{"title":{"offset":2}},"source_url":"https://github.com/dualslash/The-FAIR-Handbook/blob/main/The-FAIR-Handbook/i3.md","edit_url":"https://github.com/dualslash/The-FAIR-Handbook/edit/main/The-FAIR-Handbook/i3.md","exports":[{"format":"md","filename":"i3.md","url":"/The-FAIR-Handbook/build/i3-ee44631c4048928bd067c25e6eb503ea.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"A qualified reference is a cross-reference that explains its intent. For example, ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"MEimatbbZK"},{"type":"emphasis","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"X is regulator of Y","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"xeIquz8HFX"}],"key":"WtQoPJ2O7J"},{"type":"text","value":" is a much more qualified reference than ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"yG1YgEwFeO"},{"type":"emphasis","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"X is associated with Y","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ET7lRQn5cW"}],"key":"zlvQU9bUp9"},{"type":"text","value":", or ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"iBQfccWUI4"},{"type":"emphasis","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"X see also Y","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"UhfSt7JKV6"}],"key":"hAvVfbvcro"},{"type":"text","value":".","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Z2AC3WmtEK"}],"key":"BGShSn6eF5"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"The goal therefore is to create as many meaningful links as possible between (meta)data resources to enrich the contextual knowledge about the data, balanced against the time/energy involved in making a good data model.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"NJYmhF242q"}],"key":"tEZYdlGnLe"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"To be more concrete, you should specify if one dataset builds on another data set, if additional datasets are needed to  complete the data, or if complementary information is stored in a  different dataset. In particular, the scientific links between the datasets need to be described. Furthermore, all datasets need to be  properly cited (i.e., including their globally unique and persistent  identifiers).","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"QB4MOZFcav"}],"key":"VRWGaVW974"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"link","url":"https://www.go-fair.org/fair-principles/i3-metadata-include-qualified-references-metadata/","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"inlineCode","value":"I3: (Meta)data include qualified references to other (meta)data","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"uMU1OVxYrZ"}],"urlSource":"https://www.go-fair.org/fair-principles/i3-metadata-include-qualified-references-meta